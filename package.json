{
  "name": "nivasa",
  "version": "1.0.0",
  "private": true,
  "description": "Nivasa - Indian rental discovery platform (MERN monorepo)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "dev:api": "npm run dev -w backend",
    "dev:full": "concurrently -k -n api,web -c cyan,green \"npm:dev:api\" \"npm:dev\"",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "preview": "npm run preview -w frontend",
    "test": "npm run test -w frontend && npm run test -w backend",
    "test:frontend": "npm run test -w frontend",
    "test:backend": "npm run test -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
