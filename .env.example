# Frontend-only demo configuration. Never put secrets in Vite env files.
# Map provider: "osm" (Leaflet + OpenStreetMap) or "demo" (built-in schematic preview)
VITE_MAP_PROVIDER=osm

# Reserved for future backend integration. Left blank in the frontend phase.
VITE_API_BASE_URL=
VITE_AI_SERVICE_URL=
VITE_AUTH_PROVIDER=
