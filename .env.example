# API
PORT=5000
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173

# Persistence: unset for the explicit local JSON-file fallback
MONGODB_URI=
# Required in production; leave unset only for local development
JWT_SECRET=replace-with-a-long-random-secret-before-production
# Optional local JSON storage directory; production requires MongoDB or explicit opt-in
NIVASA_DATA_DIR=
ALLOW_FILE_STORAGE_IN_PRODUCTION=false

# Geocoding (OSM / Photon)
GEOCODER_USER_AGENT=Nivasa/1.0 (Indian rental discovery; contact: admin@nivasa.in)
GEOCODE_MIN_INTERVAL_MS=1200
PHOTON_URL=https://photon.komoot.io
NOMINATIM_URL=https://nominatim.openstreetmap.org
DISCOVERY_QUERIES=hostel,guest house,student accommodation,pg accommodation
DISCOVERY_CACHE_TTL_MS=900000
FRESHNESS_DAYS=30

# Reserved for an authorized Google Places adapter; not required for OSM discovery
GOOGLE_MAPS_API_KEY=
# Reserved for a future mail transport. No email is sent until it is implemented.
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
