# Server
PORT=5000

# Optional. Without this the API serves the labelled demo dataset from memory.
MONGODB_URI=

# Comma-separated origins allowed to call the API from a browser.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173

# Client (Vite) — leave as /api when using the included proxy or single-deploy server.
VITE_API_URL=/api
VITE_MAP_PROVIDER=leaflet
